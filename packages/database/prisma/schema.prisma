generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Seuls ces deux contrats sont dans le périmètre.
enum ContractType {
  ALTERNANCE
  INTERNSHIP
}

/// Seuls ces métiers sont dans le périmètre.
///
/// SOFTWARE_ENGINEERING accueille les postes clairement orientés développement
/// que les trois premiers ne décrivent pas, et OTHER_DEVELOPER ceux dont la
/// spécialité n'est pas tranchée. Aucun des deux n'est un fourre-tout : une
/// offre hors développement est rejetée, pas rangée ici.
///
/// La data et le mobile restent stockables : le flux ne les montre pas par
/// défaut, ce qui est un réglage de `@findit/shared` et non une règle de la base.
enum RoleCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  SOFTWARE_ENGINEERING
  OTHER_DEVELOPER
  MOBILE
  DATA_ANALYST
  DATA_ENGINEER
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum SalaryPeriod {
  HOUR
  MONTH
  YEAR
}

/// États du pipeline. Seul PUBLISHED est visible publiquement.
enum JobStatus {
  DISCOVERED
  FETCHED
  NORMALIZED
  VALIDATED
  QUARANTINED
  REJECTED
  DUPLICATE
  PUBLISHED
  EXPIRED
  SOURCE_UNAVAILABLE
}

enum SkillKind {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD_TOOL
  DEV_TOOL
  SOFT_SKILL
  LANGUAGE
}

/// Distingue une compétence exigée d'une compétence souhaitée, car le score
/// CV/offre les pondère différemment.
enum SkillRequirement {
  REQUIRED
  PREFERRED
}

model Company {
  id   String @id @default(uuid(7))
  slug String @unique

  name String
  /// Nom réduit à une forme comparable, utilisé pour rapprocher les doublons.
  normalizedName String

  website    String?
  careerUrl  String?
  logoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs            Job[]
  aliases         CompanyAlias[]
  sources         CompanySource[]
  classifications CompanyClassification[]

  @@index([normalizedName])
}

model Job {
  id   String @id @default(uuid(7))
  slug String @unique

  title String
  /// Titre débarrassé des mentions H/F, du type de contrat et des codes
  /// internes, afin de comparer deux publications de la même offre.
  normalizedTitle String
  roleCategory    RoleCategory

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  description      String
  responsibilities String[]
  requirements     String[]
  benefits         String[]

  contractType ContractType
  workMode     WorkMode

  city String
  /// Restreint aux départements d'Île-de-France par une contrainte de contrôle.
  departmentCode String
  postalCode     String?
  latitude       Float?
  longitude      Float?

  salaryMin    Int?
  salaryMax    Int?
  salaryPeriod SalaryPeriod?
  salaryText   String?

  studyLevel String?
  startDate  DateTime?
  duration   String?

  /// Date de publication réelle à la source. Jamais renseignée avec la date de
  /// découverte : une offre sans date fiable ne peut pas être publiée.
  publishedAt DateTime
  /// Premier passage du collecteur sur cette offre.
  firstSeenAt DateTime
  /// Dernier passage ayant confirmé que l'offre est toujours en ligne.
  lastSeenAt  DateTime
  updatedAt   DateTime @updatedAt
  /// publishedAt + 72 h. Stocké pour que l'expiration soit indexable.
  expiresAt   DateTime

  canonicalUrl String
  applyUrl     String?

  externalId    String?
  requisitionId String?

  duplicateGroupId    String?
  duplicateGroup      DuplicateGroup? @relation(fields: [duplicateGroupId], references: [id], onDelete: SetNull)
  duplicateConfidence Float?

  schoolRiskScore   Int
  schoolRiskReasons String[]
  fraudRiskScore    Int
  fraudRiskReasons  String[]
  dataQualityScore  Int
  confidenceScore   Int

  status JobStatus

  /// Vrai pour une offre de démonstration produite par le script de seed. Elle
  /// ne correspond à aucun employeur réel et l'interface doit la signaler. Le
  /// drapeau est porté par la donnée elle-même plutôt que déduit d'un nom, afin
  /// qu'une offre factice ne puisse jamais passer pour authentique.
  isDemo Boolean @default(false)

  sources                JobSource[]
  skills                 JobSkill[]
  classificationDecision JobClassificationDecision[]
  schoolDecisions        SchoolDetectionDecision[]
  fraudDecisions         FraudDetectionDecision[]
  duplicateDecisions     DuplicateDecision[]
  processingLogs         ProcessingLog[]
  matches                JobMatch[]
  sourceResumeMatches    SourceResumeMatch[]
  sourceCoverLetters     SourceCoverLetter[]
  coverLetters           CoverLetter[]
  telegramNotifications  TelegramJobNotification[]

  /// Une même source ne peut pas décrire deux fois la même offre.
  @@unique([companyId, externalId])
  /// Sert la liste publique : offres publiées, triées par date de publication.
  @@index([status, publishedAt])
  /// Sert les filtres de la liste.
  @@index([status, roleCategory, publishedAt])
  @@index([status, departmentCode, publishedAt])
  @@index([status, contractType, publishedAt])
  /// Sert le travail d'expiration.
  @@index([status, expiresAt])
  @@index([duplicateGroupId])
  @@index([normalizedTitle])
}

/// Chaque endroit où une offre a été vue. La fusion des doublons conserve tous
/// les liens : aucun n'est perdu au profit de la source retenue.
model JobSource {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name String
  url  String
  /// Rang de confiance de la source. Le plus élevé devient la source canonique.
  priority Int
  /// Dernière vérification que ce lien répond toujours.
  checkedAt DateTime

  createdAt DateTime @default(now())

  snapshots JobSourceSnapshot[]

  @@unique([jobId, url])
  @@index([jobId, priority])
}

model Skill {
  id   String @id @default(uuid(7))
  slug String @unique

  name String
  kind SkillKind

  createdAt DateTime @default(now())

  jobs    JobSkill[]
  aliases SkillAlias[]

  @@index([kind])
}

model JobSkill {
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)

  requirement SkillRequirement

  @@id([jobId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Entreprises : variantes de nom, sources de collecte, nature réelle
// ---------------------------------------------------------------------------

/// Variantes sous lesquelles une entreprise publie ses offres. Sert à rapprocher
/// « ACME SAS », « Acme France » et « acme » sans les fusionner à l'aveugle.
model CompanyAlias {
  id String @id @default(uuid(7))

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  alias           String
  normalizedAlias String

  createdAt DateTime @default(now())

  @@unique([companyId, normalizedAlias])
  @@index([normalizedAlias])
}

enum AtsKind {
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  SMARTRECRUITERS
  WORKDAY
  TEAMTAILOR
  RECRUITEE
  TALEO
  SAP_SUCCESSFACTORS
  WELCOMEKIT
  FLATCHR
  JOBTEASER
  OTHER
  UNKNOWN
}

/// Régime d'accès à une source, tenu à jour dans la documentation de conformité.
/// Aucune collecte n'est permise hors des régimes explicitement autorisés.
enum SourceAccessStatus {
  OFFICIAL_API
  PUBLIC_FEED
  AUTHORIZED_CRAWL
  SEARCH_ENGINE_DISCOVERY_ONLY
  MANUAL_IMPORT
  DISABLED_PENDING_PERMISSION
  PROHIBITED
}

/// Où et comment collecter les offres d'une entreprise.
model CompanySource {
  id String @id @default(uuid(7))

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  domain        String
  careerUrl     String?
  atsKind       AtsKind @default(UNKNOWN)
  atsIdentifier String?

  accessStatus SourceAccessStatus

  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  lastSuccessfulRunAt DateTime?
  fetchedJobCount     Int       @default(0)
  /// Confiance sur 100 dans le rattachement de cette source à l'entreprise.
  confidence          Int
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, domain])
  @@index([accessStatus])
  @@index([atsKind])
}

/// Nature réelle de l'organisation qui publie. Une école ne doit jamais
/// apparaître comme employeur.
enum CompanyKind {
  EMPLOYER
  SCHOOL
  TRAINING_ORGANISATION
  BOOTCAMP
  RECRUITMENT_AGENCY
  UNKNOWN
}

/// Origine d'une décision, pour distinguer une règle d'une sortie de modèle et
/// d'une correction humaine.
enum DecisionSource {
  RULE
  AI
  HUMAN
}

/// Historique des classifications d'entreprise. Les lignes ne sont jamais
/// écrasées : une correction ajoute une décision et conserve la précédente.
model CompanyClassification {
  id String @id @default(uuid(7))

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind            CompanyKind
  schoolRiskScore Int
  reasons         String[]

  decidedBy DecisionSource
  decidedAt DateTime       @default(now())

  /// Version d'instruction utilisée quand la décision vient d'un modèle.
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([companyId, decidedAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Connecteurs : exécution, santé, erreurs
// ---------------------------------------------------------------------------

enum ConnectorStatus {
  ACTIVE
  DISABLED
  DISABLED_PENDING_PERMISSION
  FAILING
}

model Connector {
  id   String @id @default(uuid(7))
  name String @unique

  atsKind      AtsKind            @default(UNKNOWN)
  accessStatus SourceAccessStatus
  status       ConnectorStatus    @default(DISABLED_PENDING_PERMISSION)

  /// Date de dernière vérification des conditions d'utilisation de la source.
  termsCheckedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs           ConnectorRun[]
  errors         ConnectorError[]
  companySources CompanySource[]

  @@index([status])
}

enum ConnectorRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Une exécution de collecte. Alimente le tableau technique.
model ConnectorRun {
  id String @id @default(uuid(7))

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  status     ConnectorRunStatus @default(RUNNING)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?

  pagesFetched    Int @default(0)
  jobsDiscovered  Int @default(0)
  jobsAccepted    Int @default(0)
  jobsRejected    Int @default(0)
  jobsQuarantined Int @default(0)
  duplicatesFound Int @default(0)
  errorCount      Int @default(0)

  /// Relie les journaux d'une même exécution entre les processus.
  correlationId String

  errors ConnectorError[]

  @@index([connectorId, startedAt])
  @@index([status])
  @@index([correlationId])
}

model ConnectorError {
  id String @id @default(uuid(7))

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  runId String?
  run   ConnectorRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  kind    String
  message String
  url     String?

  occurredAt DateTime @default(now())

  @@index([connectorId, occurredAt])
  @@index([runId])
}

// ---------------------------------------------------------------------------
// Traçabilité des sources
// ---------------------------------------------------------------------------

/// Contenu brut tel que reçu d'une source, à une date donnée. Permet de
/// reconstituer une décision et de détecter un changement de structure sans
/// jamais réinventer la donnée d'origine.
model JobSourceSnapshot {
  id String @id @default(uuid(7))

  jobSourceId String
  jobSource   JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  fetchedAt   DateTime @default(now())
  httpStatus  Int?
  contentType String?
  /// Empreinte du contenu, pour repérer une modification sans tout comparer.
  contentHash String
  rawContent  String?

  @@index([jobSourceId, fetchedAt])
  @@index([contentHash])
}

// ---------------------------------------------------------------------------
// Compétences
// ---------------------------------------------------------------------------

/// Formes équivalentes d'une compétence : « js », « JavaScript », « ECMAScript ».
model SkillAlias {
  id String @id @default(uuid(7))

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  alias           String
  normalizedAlias String @unique

  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Déduplication
// ---------------------------------------------------------------------------

/// Groupe d'offres considérées comme une même publication. La source canonique
/// est celle du rang le plus élevé ; les autres restent visibles comme liens.
model DuplicateGroup {
  id String @id @default(uuid(7))

  canonicalJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      Job[]
  decisions DuplicateDecision[]

  @@index([canonicalJobId])
}

enum DuplicateAction {
  MERGED
  UNMERGED
  REJECTED
}

/// Trace de chaque fusion et de chaque annulation, avec le détail du score.
/// Une fusion doit rester réversible.
model DuplicateDecision {
  id String @id @default(uuid(7))

  groupId String
  group   DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  action DuplicateAction
  score  Float
  /// Détail par critère : entreprise, titre, description, lieu, compétences, date.
  scoreBreakdown Json
  reasons        String[]

  decidedBy DecisionSource
  decidedAt DateTime       @default(now())

  @@index([groupId, decidedAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Décisions sur les offres
// ---------------------------------------------------------------------------

enum ClassificationOutcome {
  ACCEPTED
  REJECTED
  QUARANTINED
}

/// Pourquoi une offre a été acceptée, rejetée ou mise en quarantaine.
model JobClassificationDecision {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  outcome      ClassificationOutcome
  roleCategory RoleCategory?
  contractType ContractType?
  /// Confiance sur 100 dans la classification.
  confidence   Int
  reasons      String[]

  decidedBy       DecisionSource
  decidedAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([jobId, decidedAt])
  @@index([outcome])
}

/// Détection des écoles et organismes de formation publiant de fausses offres.
model SchoolDetectionDecision {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  riskScore Int
  excluded  Boolean
  /// Signaux ayant motivé la décision, cités tels quels.
  reasons   String[]

  decidedBy       DecisionSource
  decidedAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([jobId, decidedAt])
  @@index([excluded])
}

model FraudDetectionDecision {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  riskScore Int
  excluded  Boolean
  reasons   String[]

  decidedBy       DecisionSource
  decidedAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([jobId, decidedAt])
  @@index([excluded])
}

/// Journal du pipeline : une ligne par étape et par offre, avec son résultat.
model ProcessingLog {
  id String @id @default(uuid(7))

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  stage         String
  fromStatus    JobStatus?
  toStatus      JobStatus?
  succeeded     Boolean
  message       String?
  durationMs    Int?
  correlationId String

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([stage, createdAt])
  @@index([correlationId])
}

// ---------------------------------------------------------------------------
// CV, correspondance et lettre
// ---------------------------------------------------------------------------

enum ResumeFileType {
  PDF
  DOCX
  TXT
}

enum ResumeStatus {
  UPLOADED
  PARSED
  PARSE_FAILED
  DELETED
}

/// Un CV déposé sans compte. Rattaché à une session de navigateur, jamais à une
/// identité, et supprimé automatiquement à l'échéance.
model Resume {
  id String @id @default(uuid(7))

  /// Identifiant aléatoire et temporaire de session. N'est pas un identifiant
  /// d'utilisateur et ne sert à aucun suivi publicitaire.
  browserSessionId String

  fileType ResumeFileType
  fileSize Int
  /// Nom de stockage réattribué : le nom d'origine n'est jamais conservé.
  storageKey  String       @unique
  contentHash String
  status      ResumeStatus @default(UPLOADED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Échéance de suppression automatique.
  expiresAt DateTime
  deletedAt DateTime?

  analyses     ResumeAnalysis[]
  matches      JobMatch[]
  coverLetters CoverLetter[]

  @@index([browserSessionId])
  @@index([expiresAt])
}

/// Faits extraits d'un CV. Rien n'est complété : ce qui est absent reste absent
/// et remonte dans les avertissements.
model ResumeAnalysis {
  id String @id @default(uuid(7))

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  headline        String?
  summary         String?
  yearsExperience Float?
  studyLevel      String?
  location        String?
  availability    String?

  /// Faits structurés extraits tels quels : expériences, projets, formations,
  /// compétences, langues, certifications.
  extractedFacts Json
  /// Ce que l'extraction n'a pas pu établir.
  warnings       String[]
  /// Confiance sur 100 dans l'extraction.
  confidence     Int

  analysedBy      DecisionSource
  createdAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
}

/// Score indicatif entre un CV et une offre. Ce n'est pas le résultat d'un ATS
/// réel et cela ne préjuge pas de la sélection par l'employeur.
model JobMatch {
  id String @id @default(uuid(7))

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Score global sur 100.
  score Int
  /// Score par catégorie pondérée, pour que le total soit explicable.
  scoreBreakdown Json

  matchedSkills   String[]
  missingSkills   String[]
  missingKeywords String[]
  strengths       String[]
  weaknesses      String[]
  /// Suggestions portant uniquement sur la mise en valeur de l'existant.
  recommendations String[]

  /// Confiance sur 100 dans l'analyse.
  confidence Int
  /// Renseigné quand le CV ou l'offre ne contient pas assez d'éléments.
  insufficientDataWarning String?

  computedBy      DecisionSource
  createdAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  coverLetters CoverLetter[]

  @@unique([resumeId, jobId, computedBy])
  @@index([resumeId, score])
  @@index([jobId])
}

enum CoverLetterTone {
  PROFESSIONAL
  DIRECT
  ENTHUSIASTIC
  SOBER
}

/// Lettre produite à partir des seuls faits du CV et de l'offre.
model CoverLetter {
  id String @id @default(uuid(7))

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchId String?
  match   JobMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  tone    CoverLetterTone @default(PROFESSIONAL)
  subject String
  body    String
  /// Éléments du CV réellement utilisés, afin que la lettre soit vérifiable.
  usedResumeFacts Json
  /// Vrai lorsque l'utilisateur a modifié le texte à la main.
  editedByUser    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  generatedBy     DecisionSource
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
  @@index([jobId])
  @@index([expiresAt])
}

/// Instructions versionnées envoyées aux modèles. Permet de rattacher une
/// décision passée à l'instruction exacte qui l'a produite.
model PromptVersion {
  id String @id @default(uuid(7))

  name    String
  version Int
  /// Identifiant du modèle visé, par exemple « claude-opus-4-8 ».
  model   String
  content String
  /// Empreinte du contenu, pour détecter une dérive silencieuse.
  contentHash String

  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  companyClassifications CompanyClassification[]
  jobClassifications     JobClassificationDecision[]
  schoolDecisions        SchoolDetectionDecision[]
  fraudDecisions         FraudDetectionDecision[]
  resumeAnalyses         ResumeAnalysis[]
  jobMatches             JobMatch[]
  coverLetters           CoverLetter[]

  @@unique([name, version])
  @@index([name, active])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  NEW_JOB
  APPLICATION_REMINDER
}

enum NotificationStatus {
  SENT
  FAILED
  /// Envoi non effectué à dessein : mode simulation ou canal désactivé.
  SKIPPED
}

/// Une notification pour une offre, vers un chat. La clé d'idempotence empêche
/// de notifier deux fois la même offre — y compris quand une nouvelle source
/// s'ajoute à une offre déjà connue.
///
/// Aucun secret ici : ni le token du bot, ni rien qui permette de le
/// reconstituer. Le champ `detail` porte une éventuelle erreur, jamais le token.
model TelegramJobNotification {
  id String @id @default(uuid(7))

  /// hash(chatId + jobId + type). Une seule notification par triplet.
  idempotencyKey String @unique

  chatId String
  type   NotificationType

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status NotificationStatus
  detail String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([type, createdAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Espace privé du propriétaire
// ---------------------------------------------------------------------------

/// Profil du propriétaire de la plateforme. À la différence de `Resume`, qui
/// est un dépôt public anonyme et éphémère, ce profil est privé et durable :
/// il n'est accessible que derrière la clé de l'espace privé.
///
/// La plateforme est personnelle : ce profil n'existe qu'en un seul exemplaire.
/// La contrainte est portée par une valeur fixe de `singleton`, unique.
model CandidateProfile {
  id String @id @default(uuid(7))

  /// Toujours « owner ». Rend le profil unique par construction.
  singleton String @unique @default("owner")

  fullName String
  email    String?
  phone    String?
  city     String?

  targetRoles     String[]
  availability    String?
  studyProgram    String?
  school          String?
  workStudyRhythm String?

  portfolioUrl String?
  githubUrl    String?
  linkedinUrl  String?

  /// Langues et préférences, en JSON : leur forme évolue sans migration.
  languages   Json @default("[]")
  preferences Json @default("{}")

  activeResumeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// CV source du propriétaire, importé dans l'espace privé. À la différence de
/// `Resume` — dépôt public anonyme et éphémère — celui-ci est durable et privé.
///
/// Le texte extrait est conservé ; le fichier d'origine ne l'est pas encore, ce
/// qui suffit pour lire et analyser, pas pour ré-exporter l'original. La
/// déduplication par empreinte évite de stocker deux fois le même import.
model SourceResume {
  id String @id @default(uuid(7))

  fileType         ResumeFileType
  originalFileName String
  fileSize         Int
  contentHash      String @unique

  extractedText String

  structuredFacts      Json?
  structuredWarnings   String[] @default([])
  structuredConfidence Int?
  structuredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  matches SourceResumeMatch[]
  coverLetters SourceCoverLetter[]

  @@index([createdAt])
  @@index([structuredAt])
  @@index([expiresAt])
}

/// Lettre de motivation du propriétaire pour une offre précise. Distincte de
/// `CoverLetter` (dépôt public anonyme). Le texte vient du modèle local mais
/// n'est stocké qu'après vérification : toute compétence technique citée doit
/// exister dans le CV structuré. La lettre se relit et se régénère à volonté ;
/// une seule lettre courante par couple CV/offre, en cascade des deux côtés.
model SourceCoverLetter {
  id String @id @default(uuid(7))

  sourceResumeId String
  sourceResume   SourceResume @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  subject String
  /// Paragraphes de la lettre, sans formule d'adresse ni signature : le
  /// modèle de document les ajoute au rendu.
  paragraphs String[]

  /// Faits du CV que le modèle déclare avoir utilisés, pour la relecture.
  usedFacts String[]
  /// Ce que la génération signale elle-même comme fragile.
  warnings String[]

  computedBy DecisionSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceResumeId, jobId])
  @@index([jobId])
}

/// Score entre le CV source du propriétaire et une offre. Distinct de
/// `JobMatch`, qui appartient au dépôt public anonyme : les deux mondes ne
/// partagent pas leurs tables. Calculé par règles, jamais par IA, et recalculé
/// à la demande : la ligne suit le CV et l'offre (suppression en cascade).
model SourceResumeMatch {
  id String @id @default(uuid(7))

  sourceResumeId String
  sourceResume   SourceResume @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Score global sur 100.
  score Int
  /// Critères pondérés et leurs raisons, pour que le total soit explicable.
  scoreBreakdown Json

  matchedSkills   String[]
  missingSkills   String[]
  missingKeywords String[]
  strengths       String[]
  weaknesses      String[]
  /// Suggestions portant uniquement sur la mise en valeur de l'existant.
  recommendations String[]

  /// Confiance sur 100 : quantité de matière comparée, pas qualité du candidat.
  confidence Int
  /// Renseigné quand le CV ou l'offre ne contient pas assez d'éléments.
  insufficientDataWarning String?

  computedBy DecisionSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un seul score courant par couple CV/offre : recalculer remplace.
  @@unique([sourceResumeId, jobId])
  @@index([jobId])
  @@index([sourceResumeId, score])
}
