generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Seuls ces deux contrats sont dans le périmètre.
enum ContractType {
  ALTERNANCE
  INTERNSHIP
}

/// Seuls ces métiers sont dans le périmètre.
///
/// SOFTWARE_ENGINEERING accueille les postes clairement orientés développement
/// que les trois premiers ne décrivent pas, et OTHER_DEVELOPER ceux dont la
/// spécialité n'est pas tranchée. Aucun des deux n'est un fourre-tout : une
/// offre hors développement est rejetée, pas rangée ici.
///
/// La data et le mobile restent stockables : le flux ne les montre pas par
/// défaut, ce qui est un réglage de `@findit/shared` et non une règle de la base.
enum RoleCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  SOFTWARE_ENGINEERING
  OTHER_DEVELOPER
  MOBILE
  DATA_ANALYST
  DATA_ENGINEER
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum SalaryPeriod {
  HOUR
  MONTH
  YEAR
}

/// États du pipeline. Seul PUBLISHED est visible publiquement.
enum JobStatus {
  DISCOVERED
  FETCHED
  NORMALIZED
  VALIDATED
  QUARANTINED
  REJECTED
  DUPLICATE
  PUBLISHED
  EXPIRED
  SOURCE_UNAVAILABLE
}

enum SkillKind {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD_TOOL
  DEV_TOOL
  SOFT_SKILL
  LANGUAGE
}

/// Distingue une compétence exigée d'une compétence souhaitée, car le score
/// CV/offre les pondère différemment.
enum SkillRequirement {
  REQUIRED
  PREFERRED
}

model Company {
  id   String @id @default(uuid(7))
  slug String @unique

  name           String
  /// Nom réduit à une forme comparable, utilisé pour rapprocher les doublons.
  normalizedName String

  website   String?
  careerUrl String?
  logoUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs            Job[]
  aliases         CompanyAlias[]
  sources         CompanySource[]
  classifications CompanyClassification[]
  contacts        Contact[]

  @@index([normalizedName])
}

model Job {
  id   String @id @default(uuid(7))
  slug String @unique

  title           String
  /// Titre débarrassé des mentions H/F, du type de contrat et des codes
  /// internes, afin de comparer deux publications de la même offre.
  normalizedTitle String
  roleCategory    RoleCategory

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  description      String
  responsibilities String[]
  requirements     String[]
  benefits         String[]

  contractType ContractType
  workMode     WorkMode

  city           String
  /// Restreint aux départements d'Île-de-France par une contrainte de contrôle.
  departmentCode String
  postalCode     String?
  latitude       Float?
  longitude      Float?

  salaryMin    Int?
  salaryMax    Int?
  salaryPeriod SalaryPeriod?
  salaryText   String?

  studyLevel String?
  startDate  DateTime?
  duration   String?

  /// Date de publication réelle à la source. Jamais renseignée avec la date de
  /// découverte : une offre sans date fiable ne peut pas être publiée.
  publishedAt DateTime
  /// Premier passage du collecteur sur cette offre.
  firstSeenAt DateTime
  /// Dernier passage ayant confirmé que l'offre est toujours en ligne.
  lastSeenAt  DateTime
  updatedAt   DateTime @updatedAt
  /// publishedAt + 72 h. Stocké pour que l'expiration soit indexable.
  expiresAt   DateTime

  canonicalUrl String
  applyUrl     String?

  externalId    String?
  requisitionId String?

  duplicateGroupId    String?
  duplicateGroup      DuplicateGroup? @relation(fields: [duplicateGroupId], references: [id], onDelete: SetNull)
  duplicateConfidence Float?

  schoolRiskScore   Int
  schoolRiskReasons String[]
  fraudRiskScore    Int
  fraudRiskReasons  String[]
  dataQualityScore  Int
  confidenceScore   Int

  status JobStatus

  /// Vrai pour une offre de démonstration produite par le script de seed. Elle
  /// ne correspond à aucun employeur réel et l'interface doit la signaler. Le
  /// drapeau est porté par la donnée elle-même plutôt que déduit d'un nom, afin
  /// qu'une offre factice ne puisse jamais passer pour authentique.
  isDemo Boolean @default(false)

  sources                JobSource[]
  skills                 JobSkill[]
  classificationDecision JobClassificationDecision[]
  schoolDecisions        SchoolDetectionDecision[]
  fraudDecisions         FraudDetectionDecision[]
  duplicateDecisions     DuplicateDecision[]
  processingLogs         ProcessingLog[]
  telegramNotifications  TelegramJobNotification[]

  /// Une même source ne peut pas décrire deux fois la même offre.
  @@unique([companyId, externalId])
  /// Sert la liste publique : offres publiées, triées par date de publication.
  @@index([status, publishedAt])
  /// Sert les filtres de la liste.
  @@index([status, roleCategory, publishedAt])
  @@index([status, departmentCode, publishedAt])
  @@index([status, contractType, publishedAt])
  /// Sert le travail d'expiration.
  @@index([status, expiresAt])
  @@index([duplicateGroupId])
  @@index([normalizedTitle])
}

/// Chaque endroit où une offre a été vue. La fusion des doublons conserve tous
/// les liens : aucun n'est perdu au profit de la source retenue.
model JobSource {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name      String
  url       String
  /// Rang de confiance de la source. Le plus élevé devient la source canonique.
  priority  Int
  /// Dernière vérification que ce lien répond toujours.
  checkedAt DateTime

  createdAt DateTime @default(now())

  snapshots JobSourceSnapshot[]

  @@unique([jobId, url])
  @@index([jobId, priority])
}

model Skill {
  id   String @id @default(uuid(7))
  slug String @unique

  name String
  kind SkillKind

  createdAt DateTime @default(now())

  jobs    JobSkill[]
  aliases SkillAlias[]

  @@index([kind])
}

model JobSkill {
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)

  requirement SkillRequirement

  @@id([jobId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Entreprises : variantes de nom, sources de collecte, nature réelle
// ---------------------------------------------------------------------------

/// Variantes sous lesquelles une entreprise publie ses offres. Sert à rapprocher
/// « ACME SAS », « Acme France » et « acme » sans les fusionner à l'aveugle.
model CompanyAlias {
  id String @id @default(uuid(7))

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  alias           String
  normalizedAlias String

  createdAt DateTime @default(now())

  @@unique([companyId, normalizedAlias])
  @@index([normalizedAlias])
}

enum AtsKind {
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  SMARTRECRUITERS
  WORKDAY
  TEAMTAILOR
  RECRUITEE
  TALEO
  SAP_SUCCESSFACTORS
  WELCOMEKIT
  FLATCHR
  JOBTEASER
  FRANCE_TRAVAIL
  OTHER
  UNKNOWN
  /// Job board lu par un fournisseur de scraping (Apify, ScrapeGraphAI), pas un ATS d'entreprise.
  JOB_BOARD
}

/// Régime d'accès à une source, tenu à jour dans la documentation de conformité.
/// Aucune collecte n'est permise hors des régimes explicitement autorisés.
/// OWNER_ACCEPTED_SCRAPING n'est pas une autorisation de la source : c'est un
/// accès toléré, que le propriétaire a décidé d'utiliser en connaissance du
/// risque (conditions d'utilisation de la plateforme qui l'interdisent).
enum SourceAccessStatus {
  OFFICIAL_API
  PUBLIC_FEED
  AUTHORIZED_CRAWL
  SEARCH_ENGINE_DISCOVERY_ONLY
  MANUAL_IMPORT
  DISABLED_PENDING_PERMISSION
  PROHIBITED
  OWNER_ACCEPTED_SCRAPING
}

/// Où et comment collecter les offres d'une entreprise.
model CompanySource {
  id String @id @default(uuid(7))

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  domain        String
  careerUrl     String?
  atsKind       AtsKind @default(UNKNOWN)
  atsIdentifier String?

  accessStatus SourceAccessStatus

  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  lastSuccessfulRunAt DateTime?
  fetchedJobCount     Int       @default(0)
  /// Confiance sur 100 dans le rattachement de cette source à l'entreprise.
  confidence          Int
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, domain])
  @@index([accessStatus])
  @@index([atsKind])
}

/// Nature réelle de l'organisation qui publie. Une école ne doit jamais
/// apparaître comme employeur.
enum CompanyKind {
  EMPLOYER
  SCHOOL
  TRAINING_ORGANISATION
  BOOTCAMP
  RECRUITMENT_AGENCY
  UNKNOWN
}

/// Origine d'une décision, pour distinguer une règle d'une sortie de modèle et
/// d'une correction humaine.
enum DecisionSource {
  RULE
  AI
  HUMAN
}

/// Historique des classifications d'entreprise. Les lignes ne sont jamais
/// écrasées : une correction ajoute une décision et conserve la précédente.
model CompanyClassification {
  id String @id @default(uuid(7))

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind            CompanyKind
  schoolRiskScore Int
  reasons         String[]

  decidedBy DecisionSource
  decidedAt DateTime       @default(now())

  /// Version d'instruction utilisée quand la décision vient d'un modèle.
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([companyId, decidedAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Connecteurs : exécution, santé, erreurs
// ---------------------------------------------------------------------------

enum ConnectorStatus {
  ACTIVE
  DISABLED
  DISABLED_PENDING_PERMISSION
  FAILING
}

model Connector {
  id   String @id @default(uuid(7))
  name String @unique

  atsKind      AtsKind            @default(UNKNOWN)
  accessStatus SourceAccessStatus
  status       ConnectorStatus    @default(DISABLED_PENDING_PERMISSION)

  /// Date de dernière vérification des conditions d'utilisation de la source.
  termsCheckedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs           ConnectorRun[]
  errors         ConnectorError[]
  companySources CompanySource[]

  @@index([status])
}

enum ConnectorRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Une exécution de collecte. Alimente le tableau technique.
model ConnectorRun {
  id String @id @default(uuid(7))

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  status     ConnectorRunStatus @default(RUNNING)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?

  pagesFetched    Int @default(0)
  jobsDiscovered  Int @default(0)
  jobsAccepted    Int @default(0)
  jobsRejected    Int @default(0)
  jobsQuarantined Int @default(0)
  duplicatesFound Int @default(0)
  errorCount      Int @default(0)

  /// Coût facturé par la source pour cette exécution, en micro-dollars entiers
  /// (5 $ = 5 000 000). Zéro pour les sources gratuites. Le plafond mensuel des
  /// sources payantes se calcule en additionnant cette colonne.
  costMicroUsd Int @default(0)

  /// Relie les journaux d'une même exécution entre les processus.
  correlationId String

  errors ConnectorError[]

  @@index([connectorId, startedAt])
  @@index([status])
  @@index([correlationId])
}

model ConnectorError {
  id String @id @default(uuid(7))

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  runId String?
  run   ConnectorRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  kind    String
  message String
  url     String?

  occurredAt DateTime @default(now())

  @@index([connectorId, occurredAt])
  @@index([runId])
}

// ---------------------------------------------------------------------------
// Traçabilité des sources
// ---------------------------------------------------------------------------

/// Contenu brut tel que reçu d'une source, à une date donnée. Permet de
/// reconstituer une décision et de détecter un changement de structure sans
/// jamais réinventer la donnée d'origine.
model JobSourceSnapshot {
  id String @id @default(uuid(7))

  jobSourceId String
  jobSource   JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  fetchedAt   DateTime @default(now())
  httpStatus  Int?
  contentType String?
  /// Empreinte du contenu, pour repérer une modification sans tout comparer.
  contentHash String
  rawContent  String?

  @@index([jobSourceId, fetchedAt])
  @@index([contentHash])
}

// ---------------------------------------------------------------------------
// Compétences
// ---------------------------------------------------------------------------

/// Formes équivalentes d'une compétence : « js », « JavaScript », « ECMAScript ».
model SkillAlias {
  id String @id @default(uuid(7))

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  alias           String
  normalizedAlias String @unique

  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Déduplication
// ---------------------------------------------------------------------------

/// Groupe d'offres considérées comme une même publication. La source canonique
/// est celle du rang le plus élevé ; les autres restent visibles comme liens.
model DuplicateGroup {
  id String @id @default(uuid(7))

  canonicalJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      Job[]
  decisions DuplicateDecision[]

  @@index([canonicalJobId])
}

enum DuplicateAction {
  MERGED
  UNMERGED
  REJECTED
  /// Doute non tranché : les offres sont groupées en attendant un contrôle.
  REVIEW
}

/// Trace de chaque fusion et de chaque annulation, avec le détail du score.
/// Une fusion doit rester réversible.
model DuplicateDecision {
  id String @id @default(uuid(7))

  groupId String
  group   DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  action         DuplicateAction
  score          Float
  /// Détail par critère : entreprise, titre, description, lieu, compétences, date.
  scoreBreakdown Json
  reasons        String[]

  decidedBy DecisionSource
  decidedAt DateTime       @default(now())

  @@index([groupId, decidedAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Décisions sur les offres
// ---------------------------------------------------------------------------

enum ClassificationOutcome {
  ACCEPTED
  REJECTED
  QUARANTINED
}

/// Pourquoi une offre a été acceptée, rejetée ou mise en quarantaine.
model JobClassificationDecision {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  outcome      ClassificationOutcome
  roleCategory RoleCategory?
  contractType ContractType?
  /// Confiance sur 100 dans la classification.
  confidence   Int
  reasons      String[]

  decidedBy       DecisionSource
  decidedAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([jobId, decidedAt])
  @@index([outcome])
}

/// Détection des écoles et organismes de formation publiant de fausses offres.
model SchoolDetectionDecision {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  riskScore Int
  excluded  Boolean
  /// Signaux ayant motivé la décision, cités tels quels.
  reasons   String[]

  decidedBy       DecisionSource
  decidedAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([jobId, decidedAt])
  @@index([excluded])
}

model FraudDetectionDecision {
  id String @id @default(uuid(7))

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  riskScore Int
  excluded  Boolean
  reasons   String[]

  decidedBy       DecisionSource
  decidedAt       DateTime       @default(now())
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([jobId, decidedAt])
  @@index([excluded])
}

/// Journal du pipeline : une ligne par étape et par offre, avec son résultat.
model ProcessingLog {
  id String @id @default(uuid(7))

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  stage         String
  fromStatus    JobStatus?
  toStatus      JobStatus?
  succeeded     Boolean
  message       String?
  durationMs    Int?
  correlationId String

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([stage, createdAt])
  @@index([correlationId])
}

/// Instructions versionnées envoyées aux modèles. Permet de rattacher une
/// décision passée à l'instruction exacte qui l'a produite.
model PromptVersion {
  id String @id @default(uuid(7))

  name        String
  version     Int
  /// Identifiant du modèle visé, par exemple « deepseek-v4-pro ».
  model       String
  content     String
  /// Empreinte du contenu, pour détecter une dérive silencieuse.
  contentHash String

  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  companyClassifications CompanyClassification[]
  jobClassifications     JobClassificationDecision[]
  schoolDecisions        SchoolDetectionDecision[]
  fraudDecisions         FraudDetectionDecision[]

  @@unique([name, version])
  @@index([name, active])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  NEW_JOB
}

enum NotificationStatus {
  SENT
  FAILED
  /// Envoi non effectué à dessein : mode simulation ou canal désactivé.
  SKIPPED
}

/// Une notification pour une offre, vers un chat. La clé d'idempotence empêche
/// de notifier deux fois la même offre - y compris quand une nouvelle source
/// s'ajoute à une offre déjà connue.
///
/// Aucun secret ici : ni le token du bot, ni rien qui permette de le
/// reconstituer. Le champ `detail` porte une éventuelle erreur, jamais le token.
model TelegramJobNotification {
  id String @id @default(uuid(7))

  /// hash(chatId + jobId + type). Une seule notification par triplet.
  idempotencyKey String @unique

  chatId String
  type   NotificationType

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status NotificationStatus
  detail String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([type, createdAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Agent autonome (MVP V1)
// ---------------------------------------------------------------------------

enum SourceType {
  CAREER_SITE
  JOB_BOARD
  API
  RSS
  SEARCH_ENGINE
}

/// Une source web à explorer par l'agent (page carrière, job board, API, flux).
model Source {
  id       String     @id @default(uuid(7))
  name     String
  url      String
  type     SourceType
  /// Expression cron, lue par le scheduler.
  schedule String
  maxDepth Int        @default(2)
  maxPages Int        @default(50)
  priority Int        @default(50)
  enabled  Boolean    @default(true)

  lastCrawlAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  crawlJobs CrawlJob[]

  @@index([enabled, priority])
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  STOPPED
}

/// Une exécution complète de l'agent pour un objectif donné.
model AgentRun {
  id        String         @id @default(uuid(7))
  objective String
  status    AgentRunStatus @default(RUNNING)

  searches     Int @default(0)
  pages        Int @default(0)
  extracted    Int @default(0)
  validated    Int @default(0)
  duplicates   Int @default(0)
  inserted     Int @default(0)
  errors       Int @default(0)
  costMicroUsd Int @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  actions       AgentAction[]
  errorLogs     AgentError[]
  searchQueries SearchQuery[]
  crawlJobs     CrawlJob[]

  @@index([startedAt])
  @@index([status, startedAt])
}

/// Une étape du run : SEARCH, DISCOVER, CRAWL, EXTRACT, ANALYZE, VALIDATE, DEDUP, STORE, PUBLISH.
model AgentAction {
  id         String   @id @default(uuid(7))
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  kind         String
  detail       String?
  /// Ce que l'action a coûté, en micro-dollars (appels LLM, requêtes payantes).
  costMicroUsd Int     @default(0)

  createdAt DateTime @default(now())

  @@index([agentRunId, createdAt])
}

/// Une erreur rencontrée pendant le run. Retry contrôlé, jamais de boucle infinie.
model AgentError {
  id         String   @id @default(uuid(7))
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  kind    String
  message String
  retried Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([agentRunId, createdAt])
}

enum MemoryKind {
  VISITED_URL
  ANALYZED_URL
  SEARCH_QUERY
  SOURCE_PATTERN
}

/// Mémoire de l'agent : sites/URLs déjà vus, requêtes déjà faites, patterns de sources.
model AgentMemory {
  id    String     @id @default(uuid(7))
  key   String
  kind  MemoryKind
  value Json?

  lastSeenAt DateTime
  createdAt  DateTime @default(now())

  @@unique([kind, key])
}

/// Une requête de recherche générée à partir de l'objectif.
model SearchQuery {
  id         String   @id @default(uuid(7))
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  query  String
  engine String

  createdAt DateTime @default(now())

  @@index([agentRunId, createdAt])
}

enum CrawlJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Une session de crawl sur une source, lancée par un run.
model CrawlJob {
  id         String    @id @default(uuid(7))
  sourceId   String
  source     Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  status    CrawlJobStatus @default(PENDING)
  startedAt DateTime       @default(now())
  endedAt   DateTime?

  pages CrawlPage[]

  @@index([sourceId, startedAt])
}

enum CrawlPageStatus {
  PENDING
  FETCHED
  FAILED
  SKIPPED
}

/// Une page visitée pendant un crawl : URL, profondeur, contenu récupéré.
model CrawlPage {
  id         String   @id @default(uuid(7))
  crawlJobId String
  crawlJob   CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)

  url          String
  status       CrawlPageStatus @default(PENDING)
  depth        Int             @default(0)
  httpStatus   Int?
  /// HTML brut récupéré, borné en taille par le crawler.
  html         String?
  /// Texte visible extrait, pour l'extraction LLM.
  text         String?
  /// robots.txt refusait l'accès : page sautée sans la lire.
  robotsDenied Boolean         @default(false)

  crawledAt   DateTime     @default(now())
  extractions Extraction[]

  @@unique([crawlJobId, url])
  @@index([crawlJobId, depth])
}

/// Données structurées extraites d'une page par le LLM.
model Extraction {
  id          String    @id @default(uuid(7))
  crawlPageId String
  crawlPage   CrawlPage @relation(fields: [crawlPageId], references: [id], onDelete: Cascade)

  /// Sortie structurée, validée par Zod avant stockage.
  data  Json
  /// Identifiant du modèle qui a produit l'extraction.
  model String?

  createdAt DateTime @default(now())

  @@index([crawlPageId])
}

/// Contact professionnel public extrait (email/téléphone), rattaché à une entreprise.
model Contact {
  id        String   @id @default(uuid(7))
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  email     String?
  phone     String?
  /// URL de la page d'où le contact a été extrait.
  sourceUrl String

  createdAt DateTime @default(now())

  /// Une même adresse ou un même téléphone n'est enregistré qu'une fois par
  /// entreprise : la mise à jour d'un contact rejoue un upsert, jamais un doublon.
  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId])
}
