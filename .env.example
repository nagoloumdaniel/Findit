NODE_ENV=development
WEB_PORT=3100
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=findit
POSTGRES_PASSWORD=findit-local-only
POSTGRES_DB=findit
DATABASE_URL=postgresql://findit:findit-local-only@localhost:5432/findit
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3100
INTERNAL_API_KEY=local-development-key-change-me-0001
# IA : DeepSeek API uniquement (decision du 2026-10-06). La cle vit dans .env,
# jamais ici ni dans le code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Tarif du compte, en dollars par million de tokens. Facultatif : les tokens
# consommes sont toujours releves, mais un cout ne se deduit pas sans tarif.
DEEPSEEK_INPUT_USD_PER_MTOK=
DEEPSEEK_OUTPUT_USD_PER_MTOK=
SEARCH_API_PROVIDER=disabled
SEARCH_API_KEY=

# Collecte automatique (worker)
JOB_COLLECTION_CRON=0 */4 * * *
JOB_COLLECTION_TIMEZONE=Europe/Paris
WEB_SEARCH_MAX_QUERIES_PER_RUN=6

# Agent autonome (worker). Eteint par defaut : chaque run depense de vrais
# appels DeepSeek et de vraies requetes Brave.
AGENT_RUN_ENABLED=false
AGENT_COLLECTION_CRON=0 8 * * *
AGENT_OBJECTIVE=alternance et stage développeur en Île-de-France
# Plafonds de dépense des sources payantes, en dollars (plan gratuit Apify : 5 $ par mois).
SCRAPING_BUDGET_MONTHLY_USD=4.5
SCRAPING_BUDGET_CYCLE_USD=0.15
# Fournisseurs de scraping : jetons a renseigner dans .env, jamais ici.
APIFY_API_TOKEN=
# Cycle quotidien des job boards : eteint par defaut, chaque run depense du credit.
SCRAPED_SOURCES_ENABLED=false
SCRAPED_COLLECTION_CRON=0 6 * * *
SCRAPING_WTTJ_MAX_ITEMS=30
SCRAPEGRAPH_API_KEY=
# Découverte par recherche web. Sans clé, le worker collecte les entreprises
# déjà connues du registre mais n'en découvre pas de nouvelles. Reste côté serveur.
BRAVE_SEARCH_API_KEY=
# France Travail (API officielle). Inscription gratuite sur francetravail.io,
# produit "Offres d'emploi v2". Sans les deux, la source est simplement absente.
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# Notifications Telegram (worker). Éteint et en simulation par défaut :
# les deux à "true" et un token/chat sont requis pour un envoi réel.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_JOBS_PER_MESSAGE=8
TELEGRAM_MAX_JOBS_PER_RUN=30
APP_URL=http://localhost:3100
