NODE_ENV=development
WEB_PORT=3100
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=findit
POSTGRES_PASSWORD=findit-local-only
POSTGRES_DB=findit
DATABASE_URL=postgresql://findit:findit-local-only@localhost:5432/findit
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3100
INTERNAL_API_KEY=local-development-key-change-me-0001
# Espace personnel (page /moi) : mot de passe unique et secret de signature du
# cookie de session. Les deux sont optionnels — sans eux, le site public tourne
# et /moi affiche « espace personnel non configure ». A renseigner pour activer
# l'espace prive : PROFILE_PASSWORD (ce que vous tapez) et SESSION_SECRET (au
# moins 32 caracteres, genere au hasard, jamais partage).
PROFILE_PASSWORD=
SESSION_SECRET=
# IA : DeepSeek API uniquement (decision du 2026-10-06). La cle vit dans .env,
# jamais ici ni dans le code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Tarif du compte, en dollars par million de tokens. Facultatif : les tokens
# consommes sont toujours releves, mais un cout ne se deduit pas sans tarif.
# Grille publique (https://api-docs.deepseek.com/quick_start/pricing) :
# deepseek-flash, entree 0,15-0,30 $/M (creux-crete), sortie 0,60-1,20 $/M.
# Le creux vaut la moitie de la crete ; l'entree en cache coute bien moins.
# Valeurs conseillees ici : la crete et le cache manque, soit le pire cas.
DEEPSEEK_INPUT_USD_PER_MTOK=0.3
DEEPSEEK_OUTPUT_USD_PER_MTOK=1.2

# Collecte automatique (worker)
JOB_COLLECTION_CRON=0 */4 * * *
JOB_COLLECTION_TIMEZONE=Europe/Paris
WEB_SEARCH_MAX_QUERIES_PER_RUN=6

# Agent autonome (worker). Eteint par defaut : chaque run depense de vrais
# appels DeepSeek et de vraies requetes Brave.
AGENT_RUN_ENABLED=false
AGENT_COLLECTION_CRON=0 8 * * *
AGENT_OBJECTIVE=alternance et stage développeur en Île-de-France
# Decouverte seule : l'agent cherche, choisit et enregistre des entreprises au
# registre, sans crawler ni extraire. Mesure du 2026-10-07 : l'extraction de
# pages d'entreprises n'a rendu aucune offre du perimetre (0 sur 4 251) pour
# ~1 600 micro-dollars par run, alors que la decouverte a fait entrer 10
# entreprises au registre pour 812 micro-dollars.
AGENT_DISCOVERY_ONLY=true
# Plafonds de dépense des sources payantes, en dollars (plan gratuit Apify : 5 $ par mois).
SCRAPING_BUDGET_MONTHLY_USD=4.5
SCRAPING_BUDGET_CYCLE_USD=0.15
# Fournisseurs de scraping : jetons a renseigner dans .env, jamais ici.
APIFY_API_TOKEN=
# Cycle quotidien des job boards : allume par defaut depuis le 2026-10-07, parce
# que c'est la seule famille de sources qui rend (12 a 13 offres acceptees par
# cycle, contre 0 ailleurs). Le cout est borne par cycle et par mois, et sans
# APIFY_API_TOKEN le cycle ne collecte rien.
SCRAPED_SOURCES_ENABLED=true
SCRAPED_COLLECTION_CRON=0 6 * * *
# Resultats par run et par board. Serres volontairement : mesure du 2026-10-07,
# deux cycles identiques dos a dos ont rendu les memes offres et n'en ont ajoute
# aucune, pour 0,05 $ puis 0,06 $. La premiere page concentre la fraicheur.
SCRAPING_WTTJ_MAX_ITEMS=15
SCRAPING_HELLOWORK_MAX_ITEMS=15
SCRAPING_INDEED_MAX_ITEMS=20
# Découverte par recherche web. Sans clé, le worker collecte les entreprises
# déjà connues du registre mais n'en découvre pas de nouvelles. Reste côté serveur.
BRAVE_SEARCH_API_KEY=
# France Travail (API officielle). Inscription gratuite sur francetravail.io,
# produit "Offres d'emploi v2". Sans les deux, la source est simplement absente.
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# Notifications Telegram (worker). Éteint et en simulation par défaut :
# les deux à "true" et un token/chat sont requis pour un envoi réel.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_JOBS_PER_MESSAGE=8
TELEGRAM_MAX_JOBS_PER_RUN=30
APP_URL=http://localhost:3100
