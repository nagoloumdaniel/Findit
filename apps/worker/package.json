{
  "name": "@findit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "board:proof": "tsx prove-board.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src prove-board.ts --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@findit/agent": "workspace:*",
    "@findit/ai": "workspace:*",
    "@findit/config": "workspace:*",
    "@findit/crawler": "workspace:*",
    "@findit/database": "workspace:*",
    "@findit/job-connectors": "workspace:*",
    "@findit/job-pipeline": "workspace:*",
    "@findit/notifications": "workspace:*",
    "@findit/orchestrator": "workspace:*",
    "@findit/persist": "workspace:*",
    "@findit/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "bullmq": "5.80.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}
