    "@findit/database": "workspace:*",
    "@findit/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "fastify": "5.10.0",
    "mammoth": "1.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "tsx": "4.23.1"
  }
