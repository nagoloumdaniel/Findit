# Variables du worker, à coller dans Railway (service → Variables → Raw Editor).
#
# Le POURQUOI de ce fichier : recopier vingt-huit variables à la main depuis un
# `.env` de soixante lignes est l'endroit où l'on se trompe. Cette liste ne
# contient **que** ce que le schéma du worker exige ou accepte — les variables du
# web et de l'API n'ont rien à faire ici.
#
# Comment s'en servir : dupliquer ce fichier, remplir les valeurs depuis `.env`,
# puis coller le contenu dans l'éditeur brut de Railway. **Ne jamais committer la
# copie remplie** : seuls des noms de variables sont versionnés ici.
#
# La seule valeur qui ne se recopie pas est REDIS_URL : elle se référence au
# service Redis du projet.

# --- Base et file ------------------------------------------------------------
NODE_ENV=production
DATABASE_URL=
# Référence Railway, pas une valeur recopiée : ${{Redis.REDIS_URL}}
REDIS_URL=

# --- Collecte planifiée ------------------------------------------------------
JOB_COLLECTION_CRON=0 */4 * * *
JOB_COLLECTION_TIMEZONE=Europe/Paris

# --- Job boards scrapés (Apify) ---------------------------------------------
SCRAPED_SOURCES_ENABLED=true
SCRAPED_COLLECTION_CRON=0 6 * * *
APIFY_API_TOKEN=
SCRAPING_BUDGET_MONTHLY_USD=5
SCRAPING_BUDGET_CYCLE_USD=0.15
SCRAPING_WTTJ_MAX_ITEMS=15
SCRAPING_HELLOWORK_MAX_ITEMS=15
SCRAPING_INDEED_MAX_ITEMS=20

# --- Agent (recherche + crawl) ----------------------------------------------
AGENT_RUN_ENABLED=false
AGENT_DISCOVERY_ONLY=true
AGENT_COLLECTION_CRON=0 8 * * *
AGENT_OBJECTIVE=
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_QUERIES_PER_RUN=

# --- IA (structuration, matching, coût) -------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_USD_PER_MTOK=
DEEPSEEK_OUTPUT_USD_PER_MTOK=

# --- France Travail ----------------------------------------------------------
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# --- Notifications (facultatives) -------------------------------------------
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_JOBS_PER_MESSAGE=8
TELEGRAM_MAX_JOBS_PER_RUN=30

# --- Divers ------------------------------------------------------------------
APP_URL=https://finditfr.vercel.app
